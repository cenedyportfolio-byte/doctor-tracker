# Used by docker-compose.yml only. Each app also has its own .env.example
# (backend/.env.example, frontend/.env.example) for running without Docker.

# Shared by the API (signs session tokens) and the web app (verifies them).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Host ports (change them if something else is already listening)
MONGO_PORT=27017
API_PORT=4000
WEB_PORT=3000

# Optional: use an external database (e.g. MongoDB Atlas) for the Docker API instead of
# the bundled mongo container. Include the database name in the path.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor_tracker?retryWrites=true&w=majority

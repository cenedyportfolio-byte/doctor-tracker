# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# Local MongoDB started with `docker compose up -d mongo` from the repo root,
# or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/doctor_tracker

# --- Auth -------------------------------------------------------------------
# Must be at least 32 characters and IDENTICAL to JWT_SECRET in frontend/.env.local
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
COOKIE_NAME=dt_session
# Defaults to true when NODE_ENV=production. Set to false only for plain-HTTP setups.
# COOKIE_SECURE=false

# --- HTTP -------------------------------------------------------------------
# Browser origins allowed to call the API directly (comma separated).
# Not needed for the default setup, where the Next.js app proxies /api/* server-side.
CORS_ORIGINS=http://localhost:3000
# Express "trust proxy" setting (true | false | hop count | subnet list)
TRUST_PROXY=loopback, linklocal, uniquelocal

# --- Performance ------------------------------------------------------------
# In-memory cache TTL for dashboard aggregations (0 disables the cache)
STATS_CACHE_TTL_SECONDS=60

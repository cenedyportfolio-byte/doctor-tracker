{
  "name": "doctor-tracker-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Doctor Tracker (Express + MongoDB)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "explain": "tsx --env-file-if-exists=.env src/scripts/explain-queries.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:prod": "node --env-file-if-exists=.env dist/scripts/seed.js",
    "db:sync-indexes": "tsx --env-file-if-exists=.env src/scripts/sync-indexes.ts",
    "db:sync-indexes:prod": "node --env-file-if-exists=.env dist/scripts/sync-indexes.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}

# Where the Next.js server proxies /api/* requests (the Express API).
# Read at build time for `next build` / Docker images, and at startup for `next dev`.
API_URL=http://localhost:4000

# Must be IDENTICAL to JWT_SECRET in backend/.env. Used server-side only (src/proxy.ts)
# to verify the session cookie before rendering protected pages. Never exposed to the browser.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional: must match COOKIE_NAME in backend/.env if you changed it.
# SESSION_COOKIE_NAME=dt_session
